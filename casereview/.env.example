# ---------------------------------------------------------------------------
# Browser-visible settings (VITE_ prefix = bundled into the frontend; never put secrets here)
# ---------------------------------------------------------------------------
# Supabase project (omit both to run in local demo mode with browser-only storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Default extraction provider for new organizations: mock | claude
VITE_AI_MODE=mock
# Optional override of the Claude endpoint (defaults to /api/analyze in dev, or the Supabase Edge Function)
VITE_AI_ENDPOINT=
VITE_DEFAULT_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Server-only settings for the local dev AI endpoint (read by Vite's Node process, never bundled)
# Put these in .env.local, which is git-ignored.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Set to true ONLY after organizational approval and a BAA with the AI provider are in place.
AI_PROVIDER_PHI_APPROVED=false
