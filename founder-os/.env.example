# Required: Anthropic API key used by the Founder Intelligence Engine (server-side only).
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5-5).
# FOUNDER_OS_MODEL=claude-opus-5-5

# Optional: require a passcode for the engine endpoints. Strongly recommended
# before deploying anywhere public, since every call spends API credits.
# FOUNDER_OS_PASSCODE=
